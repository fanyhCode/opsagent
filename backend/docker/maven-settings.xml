<?xml version="1.0" encoding="UTF-8"?>
<!--
  容器内构建时使用的 Maven 配置：把中央仓库换成阿里云镜像。
  不做这一步，Docker 构建过程中下载依赖会非常慢，甚至因为超时直接失败。
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0">
    <mirrors>
        <mirror>
            <id>aliyunmaven</id>
            <mirrorOf>*</mirrorOf>
            <name>阿里云公共仓库</name>
            <url>https://maven.aliyun.com/repository/public</url>
        </mirror>
    </mirrors>
</settings>
