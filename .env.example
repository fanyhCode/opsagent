# ============================================================
# 部署环境变量样例
# 使用方法：
#   1. 复制本文件为 .env（.env 已被 .gitignore 排除，不会被提交）
#   2. 填入你自己的 Key
#   3. 执行 docker compose -f docker/docker-compose.yml up -d --build
# ============================================================

# DeepSeek（对话模型）
DEEPSEEK_API_KEY=sk-替换成你的key

# 阿里云百炼（向量模型）
DASHSCOPE_API_KEY=sk-替换成你的key

# 数据库 root 密码（与现有数据卷保持一致，不要随意修改）
MYSQL_ROOT_PASSWORD=opsagent123
